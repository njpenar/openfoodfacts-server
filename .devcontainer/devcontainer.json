{
  "name": "Open Food Facts - piloto universitario",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [80, 5605],
  "portsAttributes": {
    "80": {
      "label": "Open Food Facts",
      "onAutoForward": "notify"
    },
    "5605": {
      "label": "Correo de pruebas",
      "onAutoForward": "notify"
    }
  }
}
